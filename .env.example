# 复制为 .env.local 后填入真实值。
#
# 这些变量只在服务端可见。切勿添加 VITE_ 前缀，
# 也切勿在 vite.config.ts 里用 define 把它们注入前端——那等于把密钥公开发布。

# MiniMax API key（账号管理 → API Keys）
MINIMAX_API_KEY=

# MiniMax GroupId。Chat Completions 不需要，T2A 在部分区域要求带上。
# 配置了就会作为查询参数附加到 /v1/t2a_v2，留空则不带。
MINIMAX_GROUP_ID=

# API 基地址。留空使用全球站 https://api.minimax.io
#   全球站（美国/海外 token plan 用这个）  https://api.minimax.io
#   美西低延迟节点                        https://api-uw.minimax.io
#   中国大陆账号                          https://api.minimaxi.chat
#
# 注意：区域端点的作用是降低延迟。MiniMax 公开条款中没有与端点绑定的
# 数据驻留承诺，选 api-uw 不等于数据留在美国。详见 PRIVACY.md 4.3。
MINIMAX_BASE_URL=

# TTS 音色。留空使用 "Chinese (Mandarin)_Lyrical_Voice"
MINIMAX_TTS_VOICE_ID=

# 允许调用 /api/* 的来源，逗号分隔，例如：
# ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
ALLOWED_ORIGINS=
